# ─── LLM Provider: OpenRouter ─────────────────────────────────
# Add your OpenRouter API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Recruit AI
# NVIDIA NIM — workspace assistant and NVIDIA-backed AI features
NVIDIA_NIM_API_KEY=
# Optional dedicated key for the workspace assistant; falls back to the key above.
NVIDIA_NIM_API_KEY_WORKSPACE=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_FAST_LLM_MODEL=meta/llama-3.1-8b-instruct
# Model used to screen each resume in bulk screening. Leave unset to keep the
# Optional model override for bulk screening.
SCREEN_LLM_MODEL=
# Extra server time (ms) granted to a resume screen beyond the default ~290s.
# Only needed if a screening model is very slow. Leave unset for the default.
BULK_SCREENING_TIMEOUT_MS=
API_TIMEOUT_MS=30000

# Auth - Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_YOUR_SECRET_KEY
NEXT_PUBLIC_SIGN_UP_ENABLED=true
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Database - PocketBase (Self-hosted, 100% Free)
# Download PocketBase: https://pocketbase.io/docs
# Run: ./pocketbase serve --http=127.0.0.1:8090
POCKETBASE_URL=http://127.0.0.1:8090
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=change-me

# Job APIs
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_API_KEY=your_adzuna_key
JSEARCH_API_KEY=your_jsearch_key
PROXYCURL_API_KEY=

# Search APIs
SERPER_API_KEY=your_serper_key
PROSPEO_API_KEY=your_prospeo_key
BING_API_KEY=
BING_ENDPOINT=https://api.bing.microsoft.com/v7.0/search
ALLOW_LOCAL_FALLBACK=true
APOLLO_API_KEY=your_apollo_key
# Optional public HTTPS endpoint for Apollo's asynchronous phone-number webhook.
APOLLO_WEBHOOK_URL=

# ─── Email (Transactional) — TWO OPTIONS ──────────────────────
# OPTION A (RECOMMENDED): Resend → excellent deliverability, free tier 100/day
# Sign up: https://resend.com → Domains → Add domain → Get API key
# No SPF/DKIM setup needed — Resend handles it automatically
# When RESEND_API_KEY is set, SMTP is ignored.
RESEND_API_KEY=re_YOUR_RESEND_KEY

# OPTION B (fallback): SMTP — works but deliverability depends on provider
# Free Gmail SMTP → emails go to spam (personal accounts not designed for bulk)
# Better: SendGrid, Mailgun, or Amazon SES
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=RecruitAI
SMTP_FROM_EMAIL=noreply@yourdomain.com

# ─── Communication ─────────────────────────────────────────────
SENDGRID_API_KEY=SG.YOUR_SENDGRID_KEY
# Twilio Free Trial - Get yours from: https://www.twilio.com/try-twilio
# Free trial includes: $15 credit (enough for ~500 SMS or ~200 minutes)
TWILIO_ACCOUNT_SID=AC_your_trial_sid_here
TWILIO_AUTH_TOKEN=your_trial_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ─── Calendar ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Gmail send-only OAuth for candidate outreach. Add this exact callback URL in
# Google Cloud: http://localhost:3000/api/outreach/google/callback
# Use an independent random 32+ character value in production.
OUTREACH_TOKEN_SECRET=replace_with_a_random_32_character_secret
CALCOM_API_KEY=cal_your_calcom_key

# ─── Storage - PocketBase (Built-in, included in PocketBase) ──
# Files are stored in ./pb_data/storage collection
POCKETBASE_STORAGE_COLLECTION=resumes

# ─── Payments - Stripe ─────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY
STRIPE_PRICE_ID_FREE=
STRIPE_PRICE_ID_PRO=price_YOUR_PRO_PRICE_ID
STRIPE_PRICE_ID_ENTERPRISE=price_YOUR_ENTERPRISE_PRICE_ID

# Stripe Payment Link (for direct checkout)
# https://buy.stripe.com/test_aFadR96VRah2aOOdngfnO00

# ─── Payments - UPI (used by the Pro upgrade page) ─────────────
# Set YOUR UPI VPA here — this is the UPI ID shown in the QR code
# and pre-filled in the payer's UPI app. If left empty the app uses
# the defaults in src/lib/upi-config.ts.
UPI_ID=yourname@upi
UPI_PAYEE_NAME=RecruitAI
UPI_AMOUNT=20000
UPI_NOTE=RecruitAI Pro - Lifetime

# ─── Analytics ─────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_API_KEY=

# ─── Inngest (Background Jobs) ─────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=RecruitAI

# ─── Persistent storage (REQUIRED on Vercel) ───────────────────
# The app's database is a fast in-memory + data/db.json file store —
# zero network calls, nothing to hang on. On Vercel the filesystem is
# read-only, so set BLOB_READ_WRITE_TOKEN (free: https://vercel.com/blobs)
# and the whole database auto-syncs to Vercel Blob after every write.
# Media/avatar/resume uploads use the same token. No Turso needed.
BLOB_READ_WRITE_TOKEN=
# Candidate discovery: short extraction and source-grounded entity resolution.
# Uses the configured OpenRouter model.
DISCOVERY_LLM_MODEL=openrouter/free

# Agent Reach's documented Exa MCP search + Jina public-page reader.
AGENT_REACH_ENABLED=true
# Optional keys for increased upstream quotas.
EXA_API_KEY=
JINA_API_KEY=
# Absolute path to a Scout checkout (see DISCOVERY_INTEGRATIONS.md).
SCOUT_PATH=
SCOUT_PYTHON=python
# Use the same random secret across app replicas to validate report tickets.
DISCOVERY_SIGNING_SECRET=
